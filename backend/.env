APP_NAME="PackCheck API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="packcheck-dev-secret-key-super-secure-token-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL="sqlite+aiosqlite:///./packcheck.db"
DB_ECHO=False

CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8080"

STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./uploads"

REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
CELERY_TASK_ALWAYS_EAGER=True

OCR_PROVIDER="windows_media"
REGION_DETECTOR_PROVIDER="heuristic"
ANALYZE_RATE_LIMIT_PER_MINUTE=20
