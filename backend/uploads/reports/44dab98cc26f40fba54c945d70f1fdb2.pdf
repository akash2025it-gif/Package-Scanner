<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PackCheck Legal Metrology Compliance Report</title>
    <style>
        @page {
            size: A4;
            margin: 18mm 14mm 18mm 14mm;
            @bottom-right {
                content: "Page " counter(page) " of " counter(pages);
                font-family: 'Inter', sans-serif;
                font-size: 8pt;
                color: #737687;
            }
            @bottom-left {
                content: "PackCheck • Legal Metrology (Packaged Commodities) Rules, 2011";
                font-family: 'Inter', sans-serif;
                font-size: 8pt;
                color: #737687;
            }
        }

        body {
            font-family: 'Inter', Arial, sans-serif;
            color: #181c21;
            background-color: #ffffff;
            margin: 0;
            padding: 0;
            font-size: 9.5pt;
            line-height: 1.4;
        }

        .header-container {
            border-bottom: 2px solid #0051d5;
            padding-bottom: 12px;
            margin-bottom: 16px;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
        }

        .header-table td {
            vertical-align: middle;
        }

        .govt-title {
            font-size: 15pt;
            font-weight: 800;
            color: #0051d5;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: -0.01em;
        }

        .govt-subtitle {
            font-size: 8.5pt;
            color: #424655;
            margin: 2px 0 0 0;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .report-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 9999px;
            font-weight: 700;
            font-size: 9pt;
            text-transform: uppercase;
            text-align: center;
        }

        .badge-compliant {
            background-color: #e0f8f2;
            color: #006b5c;
            border: 1px solid #65fade;
        }

        .badge-non-compliant {
            background-color: #ffdad6;
            color: #ba1a1a;
            border: 1px solid #ffb4ab;
        }

        .badge-needs-review {
            background-color: #fff1d6;
            color: #b25e00;
            border: 1px solid #ffd599;
        }

        .section-title {
            font-size: 11pt;
            font-weight: 700;
            color: #0051d5;
            margin-top: 16px;
            margin-bottom: 6px;
            border-bottom: 1px solid #e0e2e9;
            padding-bottom: 3px;
        }

        .meta-grid {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 12px;
            background-color: #f8f9ff;
            border-radius: 6px;
            border: 1px solid #e6e8ef;
        }

        .meta-grid td {
            padding: 6px 10px;
            border-bottom: 1px solid #e6e8ef;
            font-size: 8.5pt;
        }

        .meta-label {
            font-weight: 600;
            color: #424655;
            width: 22%;
            text-transform: uppercase;
            font-size: 7.5pt;
        }

        .meta-val {
            color: #181c21;
            font-weight: 500;
        }

        table.declaration-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
            margin-bottom: 16px;
        }

        table.declaration-table th {
            background-color: #0051d5;
            color: #ffffff;
            font-weight: 600;
            text-align: left;
            padding: 7px 8px;
            font-size: 8pt;
            text-transform: uppercase;
        }

        table.declaration-table td {
            padding: 7px 8px;
            border-bottom: 1px solid #e0e2e9;
            font-size: 8pt;
            vertical-align: top;
        }

        table.declaration-table tr:nth-child(even) {
            background-color: #f8f9ff;
        }

        .status-pill {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 7pt;
            font-weight: 700;
            text-transform: uppercase;
        }

        .pill-pass {
            background-color: #e0f8f2;
            color: #006b5c;
        }

        .pill-fail {
            background-color: #ffdad6;
            color: #ba1a1a;
        }

        .pill-review {
            background-color: #fff1d6;
            color: #b25e00;
        }

        .pill-override {
            background-color: #f1f3fa;
            color: #555869;
            border: 1px solid #dcdfe8;
        }

        .conf-badge {
            display: inline-block;
            padding: 1px 5px;
            border-radius: 3px;
            font-size: 6.5pt;
            font-weight: 700;
        }

        .conf-high {
            background-color: #e2f8eb;
            color: #0f7b3c;
        }

        .conf-med {
            background-color: #fef4e5;
            color: #b45309;
        }

        .conf-low {
            background-color: #fee2e2;
            color: #b91c1c;
        }

        .notes-box {
            background-color: #f1f3fa;
            border-left: 3px solid #0051d5;
            padding: 9px 12px;
            font-size: 8.5pt;
            margin-top: 12px;
            border-radius: 0 5px 5px 0;
            line-height: 1.4;
        }

        .signature-section {
            margin-top: 30px;
            width: 100%;
            border-collapse: collapse;
        }

        .signature-box {
            width: 45%;
            border-top: 1px solid #737687;
            padding-top: 5px;
            font-size: 8pt;
            color: #424655;
            text-align: center;
        }

        .citation-text {
            font-size: 7.5pt;
            color: #555869;
            font-weight: 600;
        }

        .evidence-subtext {
            font-size: 7pt;
            color: #737687;
            margin-top: 3px;
            font-family: monospace;
        }
    </style>
</head>
