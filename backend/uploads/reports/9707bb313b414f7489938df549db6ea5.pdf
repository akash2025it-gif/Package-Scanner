                            <br><span style="font-size: 7.5pt; color: #424655;">Measured Font Height: <strong>12.15 mm</strong></span>
                        
                    
                </td>
                <td>
                    
                        <span class="status-pill pill-pass">COMPLIANT</span>
                    
                </td>
                <td>
                    <div class="citation-text">Rule 6(1)(d) read with Rule 8 of LMPC Rules, 2011</div>
                    
                        <div style="font-size: 8pt; margin-top: 2px;">Valid net quantity declaration: 50.0 g.</div>
                    
                </td>
            </tr>
            
            <tr>
                <td>
                    <strong>Mfg Date</strong>
                    
                </td>
                <td>
                    
                        "Mfg Date: 08/2026"
                        
                            <br><span style="font-size: 7.5pt; color: #424655;">Measured Font Height: <strong>2.67 mm</strong></span>
                        
                    
                </td>
                <td>
                    
                        <span class="status-pill pill-pass">COMPLIANT</span>
                    
                </td>
                <td>
                    <div class="citation-text">Rule 6(1)(e) of Legal Metrology (Packaged Commodities) Rules, 2011</div>
                    
                        <div style="font-size: 8pt; margin-top: 2px;">Valid month/year of manufacture or packing detected (08/2026).</div>
                    
