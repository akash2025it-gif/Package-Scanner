<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PackCheck Legal Metrology Compliance Report</title>
    <style>
        @page {
            size: A4;
            margin: 20mm 15mm 20mm 15mm;
            @bottom-right {
                content: "Page " counter(page) " of " counter(pages);
                font-family: 'Inter', sans-serif;
                font-size: 8pt;
                color: #737687;
            }
            @bottom-left {
                content: "PackCheck • Legal Metrology (Packaged Commodities) Rules, 2011";
                font-family: 'Inter', sans-serif;
                font-size: 8pt;
                color: #737687;
            }
        }

        body {
            font-family: 'Inter', Arial, sans-serif;
            color: #181c21;
            background-color: #ffffff;
            margin: 0;
            padding: 0;
            font-size: 10pt;
            line-height: 1.4;
        }

        .header-container {
            border-bottom: 2px solid #0051d5;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
        }

        .header-table td {
            vertical-align: middle;
        }

        .govt-title {
            font-size: 16pt;
            font-weight: 800;
            color: #0051d5;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: -0.01em;
        }

        .govt-subtitle {
            font-size: 9pt;
            color: #424655;
            margin: 3px 0 0 0;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .report-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 9999px;
            font-weight: 700;
            font-size: 10pt;
            text-transform: uppercase;
            text-align: center;
        }

        .badge-compliant {
            background-color: #e0f8f2;
            color: #006b5c;
            border: 1px solid #65fade;
        }

        .badge-non-compliant {
            background-color: #ffdad6;
            color: #ba1a1a;
            border: 1px solid #ffb4ab;
        }

        .badge-partially-compliant {
            background-color: #fff1d6;
            color: #aa2f13;
            border: 1px solid #ffdad2;
        }

        .section-title {
            font-size: 12pt;
            font-weight: 700;
            color: #0051d5;
            margin-top: 20px;
            margin-bottom: 8px;
            border-bottom: 1px solid #e0e2e9;
            padding-bottom: 4px;
        }

        .meta-grid {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            background-color: #f8f9ff;
            border-radius: 8px;
            border: 1px solid #e6e8ef;
        }

        .meta-grid td {
            padding: 8px 12px;
            border-bottom: 1px solid #e6e8ef;
            font-size: 9pt;
        }

        .meta-label {
            font-weight: 600;
            color: #424655;
            width: 25%;
            text-transform: uppercase;
            font-size: 8pt;
        }

        .meta-val {
            color: #181c21;
            font-weight: 500;
        }

        table.declaration-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            margin-bottom: 20px;
        }

        table.declaration-table th {
            background-color: #0051d5;
            color: #ffffff;
            font-weight: 600;
            text-align: left;
            padding: 8px 10px;
            font-size: 8.5pt;
            text-transform: uppercase;
        }

        table.declaration-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #e0e2e9;
            font-size: 8.5pt;
            vertical-align: top;
        }

        table.declaration-table tr:nth-child(even) {
            background-color: #f8f9ff;
        }

        .status-pill {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 7.5pt;
            font-weight: 700;
            text-transform: uppercase;
        }

        .pill-pass {
            background-color: #e0f8f2;
            color: #006b5c;
        }

        .pill-fail {
            background-color: #ffdad6;
            color: #ba1a1a;
        }

        .pill-override {
            background-color: #fff1d6;
            color: #aa2f13;
        }

        .notes-box {
            background-color: #f1f3fa;
            border-left: 3px solid #0051d5;
            padding: 10px 14px;
            font-size: 9pt;
            margin-top: 15px;
            border-radius: 0 6px 6px 0;
        }

        .signature-section {
            margin-top: 35px;
            width: 100%;
            border-collapse: collapse;
        }

        .signature-box {
            width: 45%;
            border-top: 1px solid #737687;
            padding-top: 6px;
            font-size: 8.5pt;
            color: #424655;
            text-align: center;
        }

        .citation-text {
            font-size: 7.5pt;
            color: #737687;
            font-style: italic;
        }
    </style>
</head>
<body>

    <div class="header-container">
        <table class="header-table">
            <tr>
                <td>
                    <h1 class="govt-title">PackCheck Compliance Report</h1>
                    <div class="govt-subtitle">Department of Legal Metrology • Statutory Verification Audit</div>
                </td>
                <td style="text-align: right;">
                    
                        <div class="report-badge badge-compliant">VERIFIED COMPLIANT</div>
                    
                </td>
            </tr>
        </table>
    </div>

    <table class="meta-grid">
        <tr>
            <td class="meta-label">Report ID:</td>
            <td class="meta-val">e957c6a6-e34a-47f9-b682-f415d3a9404a</td>
            <td class="meta-label">Scan ID:</td>
            <td class="meta-val">60f794a2-28c0-4ff6-a798-dd9a88b26ca7</td>
        </tr>
        <tr>
            <td class="meta-label">Inspection Date:</td>
            <td class="meta-val">2026-09-04 08:35:50 UTC</td>
            <td class="meta-label">Enforcement Officer:</td>
            <td class="meta-val">Inspector Vikram Sharma (Inspector)</td>
        </tr>
        <tr>
            <td class="meta-label">Product Name:</td>
            <td class="meta-val"><strong>Lay&#39;s India&#39;s Magic Masala Potato Chips 50g</strong></td>
            <td class="meta-label">Brand & Category:</td>
            <td class="meta-val">Lay&#39;s (Packaged Snacks &amp; Chips)</td>
        </tr>
        <tr>
            <td class="meta-label">Manufacturer / Packer:</td>
            <td class="meta-val" colspan="3">None - None</td>
        </tr>
        <tr>
            <td class="meta-label">Inspection Location:</td>
            <td class="meta-val">Reliance Smart, Gurgaon</td>
            <td class="meta-label">Origin Country:</td>
            <td class="meta-val">India</td>
        </tr>
    </table>

    <div class="section-title">Mandatory Declaration Findings (LMPC Rules, 2011)</div>
    <table class="declaration-table">
        <thead>
