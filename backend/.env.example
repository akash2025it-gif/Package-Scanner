# ==============================================================================
# PackCheck - Legal Metrology Compliance Scanner Environment Configuration
# ==============================================================================

# Application
APP_NAME="PackCheck API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="packcheck-insecure-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL / SQLite)
# For local development without PostgreSQL running: sqlite+aiosqlite:///./packcheck.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/packcheck
DATABASE_URL="sqlite+aiosqlite:///./packcheck.db"
DB_ECHO=False

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8080"

# Storage Configuration
# Options: "local", "s3", "minio"
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./uploads"

# S3 / MinIO Settings (if STORAGE_PROVIDER is s3 or minio)
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="packcheck-labels"
S3_REGION="us-east-1"

# Celery & Redis
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
# If Celery worker is offline, enable eager mode for synchronous execution:
CELERY_TASK_ALWAYS_EAGER=True

# AI / OCR Provider Configuration
# Options: "mock", "google_vision", "tesseract"
OCR_PROVIDER="mock"
GOOGLE_APPLICATION_CREDENTIALS=""

# Region Detector Provider
# Options: "heuristic", "yolo_service"
REGION_DETECTOR_PROVIDER="heuristic"
YOLO_SERVICE_URL="http://localhost:8501/v1/models/lmpc-detector:predict"

# Rate Limiting
ANALYZE_RATE_LIMIT_PER_MINUTE=20
